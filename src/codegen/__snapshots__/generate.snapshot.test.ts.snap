"-- Generated by TFUI - Transport Fever 3 UI Editor — fichier régénéré, ne pas modifier : votre code va dans main_gui.handlers.lua
function data()
	local react = ug_require "::/gui/main/react.lua"
	local builtin = ug_require "::/gui/main/builtin.lua"
	local handlers = ug_require "tfui_example::/gui/main_gui.handlers.lua"
	
	local recipes = {}
	
	recipes.TfuiExampleMainWindow = react.RegisterWrapperRecipe("TfuiExampleMainWindow", builtin.Window, function(_params)
		local label = react.useState("hello")
		return builtin.Window {
			id = "tfui_example.main",
			title = "Exemple TFUI",
			initialX = 0.1,
			initialY = 0.1,
			expanded = true,
			meta = {
				class = "tfui-example-window",
			},
			content = builtin.BoxLayout {
				orientation = builtin.type.Orientation.Vertical,
				meta = {
					class = "my-root",
				},
				children = {
					builtin.TextView {
						text = label,
					},
					builtin.TextView {
						text = "Ligne 2",
					},
					builtin.Button {
						onClick = handlers.onApplyClick,
						content = builtin.TextView {
							text = "Appliquer",
						},
					},
				},
			},
		}
	end)
	
	return {
		TfuiExampleMainWindow = recipes.TfuiExampleMainWindow,
	}
end
"
`;
