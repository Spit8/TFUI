*.msi
*.exe
*.dmg
*.AppImage
*.deb
*.rpm

# ── Tests / couverture ───────────────────────
coverage/
*.lcov
.nyc_output/
vitest.config.*.timestamp-*
vite.config.*.timestamp-*

# ── Logs / debug ─────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pdb
*.dmp

# ── Données sensibles ────────────────────────
.env
.env.*
!.env.example
