# ── Dépendances ──────────────────────────────
node_modules/
.pnpm-store/

# ── Build front (Vite) ───────────────────────
dist/
dist-ssr/
*.local
.vite/

# ── Build Rust / Tauri ───────────────────────
src-tauri/target/
target/
src-tauri/gen/schemas/
