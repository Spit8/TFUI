{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for main and dockview popout windows",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "window-state:default",
    "opener:default",
    "store:default",
    "dialog:default",
    "fs:default",
    "shell:allow-open"
  ]
}
